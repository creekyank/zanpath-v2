// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Order {
  id              String   @id @default(cuid())
  email           String
  status          String   @default("pending") // 'pending', 'paid'
  isUsed          Boolean  @default(false)     
  
  // 修正 1：移除 fingerprint 的唯一限制，改用 index 提升查詢速度
  fingerprint     String?  

  moduleType      String   
  inputData       Json?    

  // 修正 2：Paddle 訂單號，保留唯一性
  paddleOrderId   String?  @unique 
  
  recoveryCode    String?
  codeExpiresAt   DateTime?
  lastCodeSentAt  DateTime?
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  result          Result?

  // 修正 3：新增索引，方便快速查找某個用戶的訂單
  @@index([email])
  @@index([paddleOrderId])
}

model Result {
  id          String   @id @default(cuid())
  content     String   @db.Text
  isComplete  Boolean  @default(false)
  pdfSent     Boolean  @default(false)
  
  orderId     String   @unique
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade) // 建議加上串聯刪除
  
  createdAt   DateTime @default(now())
}